{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Gravitask",
  "version": "../package.json",
  "identifier": "io.github.minstaar.gravitask",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5273",
    "beforeDevCommand": "npm run dev -- --port 5273 --strictPort",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Gravitask",
        "width": 620,
        "height": 520,
        "minWidth": 320,
        "minHeight": 300,
        "resizable": true,
        "fullscreen": false,

        "transparent": true,
        "decorations": false,
        "shadow": false,

        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["korean", "english"]
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/minstaar/gravitask/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUwM0QyOTIzNzlCNDMxM0IKUldRN01iUjVJeWs5VUNEUW1xU0IyRnJsSUIydHJjMWZwaE00MnBuM1pvYk9kejVTWEU1eDdra1QK"
    }
  }
}
